<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DayNight 가 아닌 기본 MaterialComponents(다크) 테마를 사용해 시스템 설정과 무관하게 항상 다크로 표시한다. -->
    <style name="Theme.TunnelAC" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg_root</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:textColorPrimary">@color/on_bg</item>
        <item name="android:textColorSecondary">@color/on_bg_secondary</item>
    </style>
</resources>
